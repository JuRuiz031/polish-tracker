# Copy to .env.local and fill in from the Supabase dashboard
# (Project Settings → API). .env.local is gitignored.

# Project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=

# The ANON / publishable key. This one is safe in the browser: every table has RLS
# enabled (supabase/migrations/0002_rls.sql), so it can only ever reach rows belonging
# to the signed-in user.
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# NOT here, and never prefixed with VITE_:
#
#   SUPABASE_SERVICE_ROLE_KEY bypasses every RLS policy. Anything prefixed VITE_ is
#   inlined into the client bundle by Vite and shipped to the browser, so putting the
#   service key here would publish full read/write access to the whole database.
#   It belongs only in GitHub Actions secrets, for scripts/backup.py.
# ---------------------------------------------------------------------------
